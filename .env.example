# Data layer configuration.
#
# Unset DATABASE_URL  -> zero-config on-disk SQLite (the default; dev/free-tier).
# Set   DATABASE_URL  -> Postgres/Supabase, isolated in its own schema.

# --- SQLite (default) ---
# SQLITE_PATH=coolmathgames.db

# --- Postgres / shared Supabase ---
# Use the Supabase SESSION pooler URI (:5432 on *.pooler.supabase.com). It is
# session-mode (required to pin search_path) and IPv4-friendly. The transaction
# pooler (:6543) will NOT preserve search_path and must not be used here.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The Postgres schema (namespace) this app's tables live in. Lets the app share
# one Supabase project with other apps without table collisions. Must be a bare
# SQL identifier ([A-Za-z_][A-Za-z0-9_]*). Unset -> "public" (behaves single-tenant).
# DB_SCHEMA=coolmathgames

# Set to "disable" only for a local plaintext Postgres. Supabase needs TLS.
# DATABASE_SSL=disable

# Max pool connections. Keep small behind the pooler / free tier.
# PGPOOL_MAX=3
